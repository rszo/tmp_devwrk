<Page
    x:Class="SelfregiApp.Views.Page5"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:SelfregiApp.Views"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    Title="Page5">

  <Page.Resources>
    <Style x:Key="font24brown" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF533745"/>
      <Setter Property="FontFamily" Value="MS UI Gothic"/>
      <Setter Property="FontSize" Value="32"/>
    </Style>
    <Style x:Key="font48black" TargetType="TextBlock">
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="FontFamily" Value="MS UI Gothic"/>
      <Setter Property="FontSize" Value="64"/>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <TextBlock Text="クレジット支払" Style="{DynamicResource font36brown}"/>
    <Line Grid.Row="1" Margin="10" X2="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" Stroke="Black"/>
    <TextBlock Grid.Row="2" Text="クレジットカードを読み込んでください。" Style="{DynamicResource font18brown}"/>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <TextBlock Grid.ColumnSpan="3" Grid.Row="1" Text="決済金額" Style="{DynamicResource font24brown}"/>
      <TextBlock Grid.Row="3" Text="\" Style="{DynamicResource font48black}"/>
      <TextBlock Grid.Column="1" Grid.Row="3" Text="TextBlock" HorizontalAlignment="Right" Style="{DynamicResource font48black}"/>
      <Image Grid.Column="3" Grid.RowSpan="5" Source="/Resources/screen01.png" Width="600" Height="400"/>
    </Grid>
  </Grid>
</Page>
